# Copy to backend/.env for local overrides. Nothing here is required.
# "fake" (default) is deterministic and needs no API key.
LLM_PROVIDER=fake
# Only used when LLM_PROVIDER=openai (optional, not implemented yet).
OPENAI_API_KEY=
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=data/app.db
# Failure injection for demos/E2E: get_interview_status always fails for this candidate id
# (e.g. cand_priya). Empty = off.
INJECT_INTERVIEW_FAILURE_FOR=
